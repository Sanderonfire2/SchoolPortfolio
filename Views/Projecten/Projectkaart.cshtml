@model SchoolPortfolio.Models.Project
@{
    string JaarSlug(string? j) => (j ?? "").ToLowerInvariant().Replace(" ", "-");
    string VakSlug(string v) => v.ToLowerInvariant().Replace(" ", "-").Replace("ë", "e").Replace("é", "e");
}
<article class="projectkaart">
    <a class="projectkaart-beeld" href="/projecten/@Model.Slug" tabindex="-1" aria-hidden="true">
        @if (!string.IsNullOrWhiteSpace(Model.CoverPad))
        {
            <img src="@Model.CoverPad" alt="" loading="lazy" />
        }
        else
        {
            <span class="beeld-placeholder" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M4 5h16v14H4Zm2 2v7l3-3 4 5 4-4 3 2V7Zm2.5 2A1.5 1.5 0 1 1 8 7.5 1.5 1.5 0 0 1 10.5 9Z" /></svg>
            </span>
        }
    </a>
    <div class="projectkaart-meta">
        @if (!string.IsNullOrWhiteSpace(Model.Schooljaar))
        {
            <a href="/projecten/@JaarSlug(Model.Schooljaar)@(string.IsNullOrWhiteSpace(Model.Vak) ? "" : "/" + VakSlug(Model.Vak))">
                @Model.Schooljaar@(string.IsNullOrWhiteSpace(Model.Vak) ? "" : $" · {Model.Vak}")
            </a>
            @if (!string.IsNullOrWhiteSpace(Model.Periode))
            {
                <span> · </span>
            }
        }
        <span>@Model.Periode</span>
    </div>
    <h3><a href="/projecten/@Model.Slug">@Model.Titel</a></h3>
    <p>@Model.KorteSamenvatting</p>
</article>
