@using SchoolPortfolio.Data
@using SchoolPortfolio.Models
@model ContactFormulier
@inject SiteDbContext Db
@{
    ViewData["Titel"] = "Contact";
    var profiel = Db.Profielen.FirstOrDefault();
    var introductie = Db.PaginaInhouden.Find("intro-contact")?.Inhoud;
}

<section class="pagina">
    <div class="container">
        <span class="over-label">Contact</span>
        <h1 class="hero-titel" style="font-size:clamp(2rem,5vw,3rem);">Contact</h1>
        @if (!string.IsNullOrWhiteSpace(introductie))
        {
            <p class="hero-intro">@introductie</p>
        }
    </div>
</section>

<section class="pagina" style="padding-top:0;">
    <div class="container contactgrid">
        <div>
            <h3 style="font-size:1.25rem; margin-bottom:1rem;">Rechtstreeks bereiken</h3>
            <dl class="feitelijst" style="max-width:28rem;">
                @if (!string.IsNullOrWhiteSpace(profiel?.Email))
                {
                    <div><dt>E-mail</dt><dd><a href="mailto:@profiel.Email">@profiel.Email</a></dd></div>
                }
                @if (!string.IsNullOrWhiteSpace(profiel?.Telefoon))
                {
                    <div><dt>Telefoon</dt><dd><a href="tel:@profiel.Telefoon.Replace(" ", "")">@profiel.Telefoon</a></dd></div>
                }
                @if (!string.IsNullOrWhiteSpace(profiel?.LinkedInUrl))
                {
                    <div><dt>LinkedIn</dt><dd><a href="@profiel.LinkedInUrl" rel="noopener" target="_blank">Profiel openen ↗</a></dd></div>
                }
                @if (!string.IsNullOrWhiteSpace(profiel?.Woonplaats))
                {
                    <div><dt>Woonplaats</dt><dd>@profiel.Woonplaats</dd></div>
                }
            </dl>
            <p class="formuliernota">Ik reageer doorgaans binnen één à twee werkdagen.</p>
        </div>

        <div>
            @if (TempData["BevestigingBericht"] is string bevestiging)
            {
                <div class="kenbaar kenbaar--ok" role="status">@bevestiging</div>
            }
            <form method="post" asp-controller="Home" asp-action="Contact">
                @Html.AntiForgeryToken()
                <div class="beheer-kolommen">
                    <div class="veld">
                        <label asp-for="Naam">Naam</label>
                        <input class="invoer" asp-for="Naam" autocomplete="name" maxlength="100" placeholder="Bijv. Jan Janssens" />
                        <span class="veldfout" asp-validation-for="Naam"></span>
                    </div>
                    <div class="veld">
                        <label asp-for="Email">E-mailadres</label>
                        <input class="invoer" asp-for="Email" type="email" autocomplete="email" maxlength="150" placeholder="bijv. naam@voorbeeld.be" />
                        <span class="veldfout" asp-validation-for="Email"></span>
                    </div>
                </div>
                <div class="veld">
                    <label asp-for="Onderwerp">Onderwerp <span style="text-transform:none;font-weight:400;">(optioneel)</span></label>
                    <input class="invoer" asp-for="Onderwerp" maxlength="150" placeholder="Waar gaat je bericht over?" />
                </div>
                <div class="veld">
                    <label asp-for="Inhoud">Bericht</label>
                    <textarea class="invoer" asp-for="Inhoud" rows="6" maxlength="4000" id="contactInhoud"
                              placeholder="Schrijf hier je bericht — bijvoorbeeld je vraag of een voorstel." data-karakterteller="contactTeller"></textarea>
                    <div style="display:flex; justify-content:space-between; gap:1rem; align-items:center; margin-top:0.25rem;">
                        <span class="veldfout" asp-validation-for="Inhoud"></span>
                        <span class="formuliernota" id="contactTeller" aria-live="polite">0 / 4000</span>
                    </div>
                </div>
                <button class="knop knop--primair" type="submit">Bericht versturen <span aria-hidden="true">→</span></button>
            </form>
        </div>
    </div>
</section>
